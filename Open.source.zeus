-- MANUAL BUTTON
-- ===========================================================================
local pg = LP:WaitForChild("PlayerGui")
if pg:FindFirstChild("Zeus_SpamUI") then pg.Zeus_SpamUI:Destroy() end

local spamGui = Instance.new("ScreenGui", pg)
spamGui.Name = "Zeus_SpamUI"
spamGui.ResetOnSpawn = false
spamGui.IgnoreGuiInset = true
spamGui.DisplayOrder = 99999
spamGui.Enabled = false

local FADED_BLUE  = Color3.fromRGB(100, 150, 220)
local BG_DARK     = Color3.fromRGB(20, 22, 30)
local BG_BUTTON   = Color3.fromRGB(30, 34, 44)
local BG_ACTIVE   = Color3.fromRGB(100, 150, 220)

local frame = Instance.new("Frame", spamGui)
frame.Name = "Main"
frame.Size = UDim2.new(0, 170, 0, 110)
frame.Position = UDim2.new(0.5, -85, 0.3, 0)
frame.BackgroundColor3 = BG_DARK
frame.Active = true; frame.Draggable = true
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)
local frameStroke = Instance.new("UIStroke", frame)
frameStroke.Color = FADED_BLUE; frameStroke.Thickness = 1.5; frameStroke.Transparency = 0.3

local mainBtn = Instance.new("TextButton", frame)
mainBtn.Name = "MainButton"
mainBtn.Size = UDim2.new(1, -20, 0, 50)
mainBtn.Position = UDim2.new(0, 10, 0, 10)
mainBtn.BackgroundColor3 = BG_BUTTON
mainBtn.Text = "WAITING..."
mainBtn.TextColor3 = Color3.new(1, 1, 1)
mainBtn.Font = Enum.Font.GothamBold
mainBtn.TextSize = 16; mainBtn.AutoButtonColor = false
Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(0, 10)
local btnStroke = Instance.new("UIStroke", mainBtn)
btnStroke.Color = FADED_BLUE; btnStroke.Thickness = 1; btnStroke.Transparency = 0.5

local subLabel = Instance.new("TextLabel", frame)
subLabel.Name = "SubLabel"
subLabel.Size = UDim2.new(1, 0, 0, 30)
subLabel.Position = UDim2.new(0, 0, 1, -35)
subLabel.BackgroundTransparency = 1
subLabel.Text = "NEED DATA"
subLabel.TextColor3 = FADED_BLUE
subLabel.Font = Enum.Font.GothamBold
subLabel.TextSize = 13

local function setManualVisible(v)
    CFG.ManualBtn = v
    spamGui.Enabled = v
    if not v then CFG.ManualActive = false end
end

mainBtn.MouseButton1Click:Connect(function()
    if not PRY.remote then mainBtn.Text = "NEED BALL"; return end
    CFG.ManualActive = not CFG.ManualActive
    if CFG.ManualActive then
        mainBtn.Text = "SPAMMING"
        mainBtn.BackgroundColor3 = BG_ACTIVE
    else
        mainBtn.Text = "READY"
        mainBtn.BackgroundColor3 = BG_BUTTON
        task.delay(0.3, function()
            if not CFG.ManualActive then
                mainBtn.Text = "READY"
                subLabel.Text = "STATUS: PRIME"
            end
        end)
    end
end)

task.spawn(function()
    while S.active and spamGui.Parent do
        if not PRY.remote then
            mainBtn.Text = "WAITING..."
            subLabel.Text = "NEED DATA"
            mainBtn.BackgroundColor3 = BG_BUTTON
        elseif not CFG.ManualActive then
            mainBtn.Text = "READY"
            subLabel.Text = "STATUS: PRIME"
            mainBtn.BackgroundColor3 = BG_BUTTON
        else
            mainBtn.Text = "SPAMMING"
            local mode = cache.ure and "URE" or "RE"
            subLabel.Text = string.format("%s | %d / %d",
                mode, S.cps or 0, math.floor(cache.targetCPS or 0))
            mainBtn.BackgroundColor3 = BG_ACTIVE
        end
        task.wait(0.2)
    end
end)

