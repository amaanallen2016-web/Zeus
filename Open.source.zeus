-- ===========================================================================
-- UI · UNLOCK
-- ===========================================================================
Window:Category("Unlock")
local UnlockPage = Window:Page({ Name = "Unlock All", Icon = "138827881557940" })
local UnlockL = UnlockPage:Section({ Name = "Unlock", Side = 1 })
local UnlockR = UnlockPage:Section({ Name = "Character", Side = 2 })

UnlockL:Button({ Name = "UNLOCK ALL",
    Callback = function()
        notify("Zeus", "Loading unlock script...", 3)
        local ok2, err = pcall(function()
            loadstring(game:HttpGet("https://pastebin.com/wSuhUFTr"))()
        end)
        if ok2 then notify("Zeus", "Successfully unlocked all", 5)
        else notify("Zeus", "Unlock failed: " .. tostring(err), 5) end
    end })

UnlockR:Toggle({ Name = "Speed", Flag = "SpeedT", Default = false,
    Callback = function(v) CFG.SpeedEnabled = v end })
UnlockR:Slider({ Name = "Speed Value", Flag = "SpeedV", Min = 16, Max = 200, Default = 16, Suffix = " studs",
    Callback = function(v) CFG.SpeedValue = v end })
UnlockR:Toggle({ Name = "Jump Power", Flag = "JumpT", Default = false,
    Callback = function(v) CFG.JumpEnabled = v end })
UnlockR:Slider({ Name = "Jump Value", Flag = "JumpV", Min = 50, Max = 300, Default = 50,
    Callback = function(v) CFG.JumpValue = v end })
UnlockR:Toggle({ Name = "Infinite Jump", Flag = "IJ", Default = false,
    Callback = function(v) CFG.InfiniteJump = v end })
UnlockR:Toggle({ Name = "Noclip", Flag = "Noclip", Default = false,
    Callback = function(v) CFG.Noclip = v end })

-- ===========================================================================
-- UI · SETTINGS
-- ===========================================================================
Window:Category("Settings")
local SettingsPage = Library:CreateSettingsPage(Window, KeybindList)

local UtilPage = Window:Page({ Name = "Utilities", Icon = "10734950309" })
local UtilSec = UtilPage:Section({ Name = "Maintenance", Side = 1 })

UtilSec:Button({ Name = "Rescan for parry remote",
    Callback = function()
        PRY.found = false; PRY.remote = nil; cache.targetCPS = nil
        pcall(extractEncoder)
        notify("Zeus", "Rescanning — throw a manual parry", 3)
    end })
UtilSec:Button({ Name = "Reset adaptive rate",
    Callback = function()
        cache.targetCPS = nil; cache.failStreak = 0
        cache.lastClean = os.clock()
        notify("Zeus", "Adaptive rate reset", 2)
    end })
UtilSec:Button({ Name = "Reset ball FX",
    Callback = function()
        S.ballFx = {}
        notify("Zeus", "Ball FX reset", 2)
    end })
UtilSec:Button({ Name = "Reload sound pool",
    Callback = function()
        for name, id in pairs(SOUND_IDS) do
            local s = soundPool[name]
            if s then
                s.SoundId = "rbxassetid://" .. id
                pcall(function() s:Play(); s:Stop() end)
            end
        end
        notify("Zeus", "Sounds reloaded", 2)
    end })

-- ===========================================================================
-- INIT
-- ===========================================================================
Window:Init()

Window.onUnloaded(function()
    S.active = false
    if spamGui then spamGui:Destroy() end
    for _, s in pairs(soundPool) do pcall(function() s:Destroy() end) end
    pcall(restoreMaxFPS)
end)

getgenv().ZeusStop = function()
    S.active = false
    if spamGui then spamGui:Destroy() end
end

pcall(function()
    Library:Notification({
        Title = "Zeus v21.6",
        Description = "Loaded. Do one manual parry to capture the remote.",
        Duration = 5, Icon = "73789337996373",
    })
end)

task.spawn(function()
    task.wait(0.5)
    if extractEncoder() then print("[Zeus] Encoder extracted")
    else print("[Zeus] Encoder will load after first parry") end
end)

print("[Zeus] DONE")
